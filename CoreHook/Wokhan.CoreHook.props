<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)\..\lib\net7.0\CoreHook.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)\..\native\x86\*" CopyToOutputDirectory="PreserveNewest" TargetPath="x86\%(Filename)%(Extension)" />
    <Content Include="$(MSBuildThisFileDirectory)\..\native\x64\*" CopyToOutputDirectory="PreserveNewest" TargetPath="x64\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="TraceExecution" AfterTargets="Build">
    <Message Text="Wokhan.CoreHook: Native libs have been copied from $(MSBuildThisFileDirectory)\..\native for x86 and x64 injection" Importance="High" />
  </Target>

</Project>